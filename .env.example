# Copy to .env and fill in. Never commit .env itself.

# Neon Postgres connection string. Required - app.py raises at import without it.
DATABASE_URL=

# The two targets. Defaults are baked into every module, so these are only
# needed to point the pipeline somewhere else.
CITY=Nagpur
STATE=Maharashtra

# Comma-separated origins allowed to call the API from a browser. Empty means
# no browser origin is allowed at all, which is the safe default rather than "*".
FRONTEND_ORIGIN=

# Base URL verify_deployment_readiness.py probes. Local default is fine.
API_BASE=http://localhost:8000
